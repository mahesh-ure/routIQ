<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Escalation_Action__c</fullName>
    <fieldManageability>SubscriberControlled</fieldManageability>
    <description>Action to take when SLA threshold is breached. Re-route: return record to Escalation_Return_Owner__c and re-enter routing. Notify: send email to Escalation_Notify_Email__c. Both: re-route AND notify.</description>
    <label>Escalation Action</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Re-route</fullName>
                <default>true</default>
                <label>Re-route</label>
            </value>
            <value>
                <fullName>Notify</fullName>
                <default>false</default>
                <label>Notify</label>
            </value>
            <value>
                <fullName>Both</fullName>
                <default>false</default>
                <label>Both</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
